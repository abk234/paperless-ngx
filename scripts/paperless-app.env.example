# Copy to scripts/paperless-app.env and adjust as needed.
# scripts/paperless-app.env is gitignored.

# Where backups are stored (absolute or relative to repo root)
BACKUP_DIR=../paperless-backups

# Run backup --if-due only when last backup is at least this many days old
BACKUP_INTERVAL_DAYS=30

# Keep the newest N backup folders (older ones are deleted after a successful backup)
BACKUP_KEEP=3

# Compose file relative to docker/compose/
COMPOSE_FILE=docker-compose.postgres.yml

# Host port published for the web UI (override remaps Docker to 127.0.0.1:PORT)
PAPERLESS_PORT=18000

# On update: also pull paperless-ngx upstream into the current branch (merge)
UPDATE_SYNC_ON_UPDATE=true
